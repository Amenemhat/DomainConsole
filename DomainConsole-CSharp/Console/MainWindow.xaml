 <ScrollViewer Grid.Column="1" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><Button Content="Выполнить команду" Style="{StaticResource Primary}" Click="RunEditor_Click" ToolTip="Выполнить текст из редактора. В подтверждении выберите текущий ПК или все отмеченные цели."/><Button x:Name="StopButton" Content="Остановить…" Click="Cancel_Click" Background="#DC2626" Foreground="White" ToolTip="Выбрать остановку сейчас или после текущей команды. Действует на просматриваемый ПК."/><TextBlock Text="Сценарии" FontWeight="SemiBold" Margin="0,12,0,4"/><Button Content="Сохранённые / недавние ▾" Click="ShowSuggestions_Click" ToolTip="Выбрать сохранённую или ранее введённую команду. Выбор заполняет редактор, запуск выполняется отдельно."/><TextBlock Text="Диагностика" FontWeight="SemiBold" Margin="0,12,0,4"/><Button Content="Диагностика DISM / SFC" Click="ServicingDiagnostics_Click" ToolTip="Снять состояние процессов и журналы текущего ПК за интервал задания. Ничего не исправляет. Полный собранный TXT сохраняется в Data/Diagnostics."/><Button Content="Открыть TXT / скрипт" Click="ImportText_Click" ToolTip="Открыть TXT, CMD, BAT или PS1 в редакторе. Файл не выполняется автоматически."/>
 <Expander x:Name="CommandOptions" Header="Шаги и параметры" Margin="0,4,0,0"><StackPanel Margin="0,8,0,0"><Button Content="Сохранить результат в TXT" Click="SaveOutput_Click" ToolTip="Сохранить показанный результат команды текущего компьютера в TXT."/><Button Content="Добавить шаг" Click="AddStep_Click" ToolTip="Добавить текст редактора отдельным шагом в последовательность."/><Button Content="Добавить выделенное" Click="AddSelection_Click" ToolTip="Добавить только выделенный фрагмент редактора отдельным шагом."/><Button Content="Применить правку шага" Click="EditStep_Click" ToolTip="Заменить выбранный шаг текущим текстом редактора."/><ListBox x:Name="StepList" Height="110" ItemsSource="{Binding Steps}" DisplayMemberPath="Name" SelectionChanged="Step_Changed"/><WrapPanel><Button Content="↑" Click="Up_Click" ToolTip="Переместить выбранный шаг раньше в порядке выполнения."/><Button Content="↓" Click="Down_Click" ToolTip="Переместить выбранный шаг позже в порядке выполнения."/><Button Content="Удалить" Click="RemoveStep_Click" ToolTip="Удалить выбранный шаг из набора. Сохранённые задания не меняются."/></WrapPanel><Button Content="Выполнить набор шагов" Click="Run_Click" Style="{StaticResource Primary}" ToolTip="Выполнить набор шагов сверху вниз. Цели выбираются в подтверждении."/><Button Content="Сохранить набор" Click="SaveLibrary_Click" ToolTip="Сохранить текущий набор шагов и параметры в библиотеку команд."/><Button Content="Импорт JSON" Click="ImportLibrary_Click" ToolTip="Добавить команды из JSON-библиотеки без автоматического выполнения."/><Button Content="Экспорт JSON" Click="ExportLibrary_Click" ToolTip="Сохранить библиотеку команд в JSON для переноса или резервной копии."/><CheckBox x:Name="ContinueBox" Content="Продолжать после ошибки" ToolTip="Следующие шаги будут выполнены даже после ненулевого кода. Итог сохранит ошибки предыдущих шагов."/><CheckBox x:Name="RebootBox" Content="Автоперезагрузка · 15 минут" ToolTip="Разрешить перезагрузку при необходимости после задания с предупреждением 15 минут. По умолчанию выключено."/><Button Content="Отменить перезагрузку" Click="AbortReboot_Click" ToolTip="Отменить ожидающую перезагрузку на текущем компьютере."/></StackPanel></Expander>
 <TextBlock Text="Подсказки появляются при вводе. Выбор подставляет команду; запуск — отдельной кнопкой." TextWrapping="Wrap" Foreground="#64748B" Margin="0,10,0,0"/></StackPanel></ScrollViewer>
 <Popup x:Name="SuggestionsPopup" PlacementTarget="{Binding ElementName=Editor}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True"><Border x:Name="SuggestionBorder" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="6" MaxWidth="700"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Сохранённые и недавние · Enter — выбрать, Esc — закрыть" Foreground="#64748B" Margin="4,2,4,6" TextWrapping="Wrap"/><ListBox x:Name="SuggestionList" ItemsSource="{Binding Suggestions}" MaxHeight="240" BorderThickness="0" PreviewMouseLeftButtonUp="Suggestion_Click" PreviewKeyDown="Suggestion_KeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel ToolTip="{Binding Preview}" Margin="3"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="#64748B" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border></Popup>
 </Grid></TabItem>
 <TabItem x:Name="HistoryTab" Header="История"><DockPanel Margin="10"><StackPanel DockPanel.Dock="Right" Width="172" Margin="10,0,0,0"><Button Content="Команды и параметры…" Click="HistoryDetails_Click" ToolTip="Посмотреть точные команды; скопировать, подготовить правку или повторить новым заданием."/><Button Content="Открыть результаты" Click="OpenHistory_Click" ToolTip="Открыть компьютеры, параметры и сохранённые результаты выбранного задания."/><Button Content="Продолжить очередь" Click="Resume_Click" ToolTip="Продолжить локальную очередь ещё не отправленных целей выбранного задания."/><Button Content="Повторить" Click="Retry_Click" ToolTip="Создать новый запуск с параметрами задания из истории. Цели проверьте в подтверждении."/><Button Content="Экспорт CSV" Click="ExportCsv_Click" ToolTip="Экспортировать состояния компьютеров выбранного задания в CSV."/></StackPanel><DataGrid x:Name="HistoryGrid" MouseDoubleClick="HistoryDetails_DoubleClick" SelectionChanged="History_Changed" ItemsSource="{Binding History}" IsReadOnly="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource HistoryCell}" Header="Создано" Binding="{Binding Created, Converter={StaticResource LocalDate},ConverterParameter=Short}" Width="150" MinWidth="150"/><DataGridTextColumn ElementStyle="{StaticResource HistoryCell}" Header="Действие" Binding="{Binding Name}" Width="170" MinWidth="170"/><DataGridTextColumn ElementStyle="{StaticResource HistoryCell}" Header="Команды" Binding="{Binding CommandPreview}" Width="*" MinWidth="210"/><DataGridTextColumn ElementStyle="{StaticResource HistoryCell}" Header="Итог" Binding="{Binding Summary}" Width="145" MinWidth="145"/><DataGridTextColumn ElementStyle="{StaticResource HistoryCell}" Header="ПК" Binding="{Binding Targets.Count}" Width="60" MinWidth="60"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
<TabItem x:Name="WsusTab" Header="WSUS"><DockPanel Margin="10"><StackPanel DockPanel.Dock="Right" Width="182" Margin="10,0,0,0"><TextBlock x:Name="WsusHeader" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Обновления" FontWeight="SemiBold" Margin="0,4,0,4"/><Button Content="Проверить обновления" Click="WsusScan_Click" ToolTip="Найти применимые обновления согласно политикам WSUS и запросить отправку отчёта. Обновления не устанавливает."/><Button Content="Установить обновления" Click="WsusInstall_Click" ToolTip="Скачать и установить применимые одобренные обновления WSUS, затем запросить отчёт. Цели выбираются в подтверждении."/><Button x:Name="WsusStopButton" Content="Остановить…" Click="Cancel_Click" Background="#B94A48" Foreground="White" ToolTip="Запросить отмену WUA либо остановку после текущего обновления. Запрос не означает мгновенного завершения установщика."/><Button Content="Прочитать отчёт сервера" Click="Wsus_Click" ToolTip="Прочитать данные текущего компьютера или всех отмеченных целей с сервера WSUS. Область выбирается в подтверждении."/><Expander x:Name="WsusDiagnosticsGroup" IsExpanded="True" Expanded="DiagnosticGroup_Changed" Collapsed="DiagnosticGroup_Changed" Margin="0,10,0,0"><Expander.Header><TextBlock Text="Диагностика и восстановление" TextWrapping="Wrap" Width="145"/></Expander.Header><StackPanel><Button Content="Диагностика отчёта" Click="DeliveryDiagnostics_Click" ToolTip="Запросить отправку отчёта без поиска и установки обновлений; собрать данные клиента и IIS сервера WSUS за один интервал. Цели выбираются в подтверждении."/><Button Content="Восстановить отчётность" Click="RecoverReport_Click" ToolTip="Очистить очередь неотправленных событий; затем проверить обновления и запросить отчёт. Требуется подтверждение целей."/><Button Content="Очистить кэш…" Click="CacheCleanup_Click" ToolTip="Выбрать очистку Download, очереди или всей SoftwareDistribution; резервная копия необязательна."/><Button Content="Диагностика ожидания" Click="WaitingDiagnostics_Click" ToolTip="Прочитать процессы и события параллельно с активным WSUS. Установку не останавливает."/><Button Content="Defender…" Click="Defender_Click" ToolTip="Диагностика службы, платформы и сбоев Defender; откат или сброс платформы доступны с подтверждением после завершения обновлений."/><Button Content="Диагностика клиента" Click="WsusDiagnostics_Click" ToolTip="Запустить диагностику политик, служб, прокси и событий Windows Update на целях из подтверждения; сбор WindowsUpdate.log ограничен пятью минутами."/></StackPanel></Expander><TextBlock x:Name="WsusStage" Visibility="Collapsed"/><ProgressBar x:Name="WsusProgress" Visibility="Collapsed"/></StackPanel><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*" MinHeight="100"/><RowDefinition Height="6"/><RowDefinition Height="2*" MinHeight="80"/></Grid.RowDefinitions><TextBlock Text="Журнал клиента" Margin="0,0,0,6" FontWeight="SemiBold"/><local:LogViewer Grid.Row="1" x:Name="WsusOutput" Margin="0"/><GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="#CBD5E1"/><DockPanel Grid.Row="3"><TextBlock x:Name="WsusReportTitle" DockPanel.Dock="Top" Text="Данные сервера WSUS о выбранном ПК" Margin="0,6" FontWeight="SemiBold"/><TextBox x:Name="WsusServerOutput" Margin="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/></DockPanel></Grid></DockPanel></TabItem> <TabItem x:Name="SettingsTab" Header="Настройки"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="650" HorizontalAlignment="Left"><CheckBox x:Name="AutoScrollSetting" Content="Автопрокрутка журналов" Checked="AutoScroll_Changed" Unchecked="AutoScroll_Changed" ToolTip="Следовать за последними записями в журналах команд и WSUS. Настройка сохраняется." Margin="0,0,0,16"/><TextBlock Text="Навигация и выполнение" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Компьютеров в списке последних (5–200); активные задания остаются видимыми" TextWrapping="Wrap"/><TextBox x:Name="RecentLimitBox" Text="20" Width="100" HorizontalAlignment="Left"/><TextBlock Text="Параллельность: 0 — без ограничения"/><TextBox x:Name="LimitBox" Text="0" Width="100" HorizontalAlignment="Left"/><Button Content="Сохранить параметры навигации" Click="SaveNavigation_Click" HorizontalAlignment="Left" ToolTip="Сохранить количество последних компьютеров и параллельность запусков."/><Separator Margin="0,16"/><TextBlock Text="Ожидание и оформление" FontWeight="SemiBold"/><TextBlock Text="Предупреждать после минут без изменения прогресса (1–120)"/><TextBox x:Name="StallMinutesBox" Text="10" Width="100" HorizontalAlignment="Left"/><ComboBox x:Name="ThemeBox" Width="240" HorizontalAlignment="Left" SelectedIndex="0"><ComboBoxItem Content="Сине-серая"/><ComboBoxItem Content="Зелёная"/><ComboBoxItem Content="Сливовая"/></ComboBox><Button Content="Сохранить ожидание и палитру" Click="SaveOperationSettings_Click" HorizontalAlignment="Left"/><Separator Margin="0,16"/><TextBlock Text="Возраст отчёта для автоматической диагностики, часов (1–720)"/><TextBox x:Name="ReportAgeBox" Text="24" Width="100" HorizontalAlignment="Left"/><Button Content="Сохранить порог отчётности" Click="SaveReportAge_Click" HorizontalAlignment="Left"/><TextBlock Text="Сервер WSUS" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock Text="Доменное имя сервера для административного подключения WinRM"/><TextBox x:Name="WsusHost" Width="420" HorizontalAlignment="Left"/><TextBlock Text="Порт WSUS API на сервере"/><TextBox x:Name="WsusPort" Text="8530" Width="100" HorizontalAlignment="Left"/><CheckBox x:Name="WsusSsl" Content="WSUS API использует HTTPS"/><TextBlock Text="Источник обновлений клиента читается из его политик WUServer / UseWUServer. Эти настройки приложения не меняют политики клиента." TextWrapping="Wrap" Foreground="#64748B" Margin="0,8,0,16"/><Button Content="Сохранить настройки" Style="{StaticResource Primary}" Click="SaveWsus_Click" HorizontalAlignment="Left" ToolTip="Сохранить адрес и параметры административного подключения к серверу WSUS."/><Separator Margin="0,16"/><TextBlock Text="Очистка на клиентах: дней после сохранения журналов"/><TextBox x:Name="CopiedDays" Text="7" Width="90" HorizontalAlignment="Left"/><TextBlock Text="Дней хранения неполученных результатов"/><TextBox x:Name="UncopiedDays" Text="30" Width="90" HorizontalAlignment="Left"/><Button Content="Сохранить сроки очистки" Click="SaveRetention_Click" ToolTip="Сроки применяются при следующей передаче задания. Активные задания и действия после перезагрузки сохраняются."/><TextBlock Text="Диагностика: минут до начала задания"/><TextBox x:Name="DiagnosticMinutes" Text="15" Width="100" HorizontalAlignment="Left" ToolTip="Журналы от начала задания минус указанное число минут до текущего снимка. Без задания — последний час. Диапазон 0–1440."/><Button Content="Сохранить интервал диагностики" Click="SaveDiagnosticSettings_Click" HorizontalAlignment="Left" ToolTip="Сохранить интервал поиска предшествующих ошибок в диагностических журналах."/></StackPanel></ScrollViewer></TabItem>
 </TabControl><DockPanel Grid.Row="2" Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="Копировать" Click="CopyError_Click" Margin="6,0,0,0" ToolTip="Скопировать сообщение нижней строки состояния."/><TextBox x:Name="StatusBar" Margin="0" Padding="6,4" IsReadOnly="True" Text="Готово. Отметьте компьютеры в дереве." TextWrapping="Wrap" MaxHeight="48" VerticalScrollBarVisibility="Auto"/></DockPanel></Grid></Grid></Window>
