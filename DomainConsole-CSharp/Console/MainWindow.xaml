<Window x:Class="DomainConsole.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DomainConsole" Title="Domain Console · 0.6" Icon="Assets/DomainConsole.ico" Width="1480" Height="940" MinWidth="1000" MinHeight="640" Background="#F4F7FB" FontFamily="Segoe UI" FontSize="13" Foreground="#0F172A">
 <Window.Resources><local:LocalDateConverter x:Key="LocalDate"/></Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="290" MinWidth="220" MaxWidth="440"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#102239"><DockPanel Margin="10"><StackPanel DockPanel.Dock="Top"><TextBlock Text="КОМПЬЮТЕРЫ" Foreground="#8BA7CC" FontWeight="SemiBold" Margin="4,0,0,8"/><TextBlock Text="Поиск по имени или ОС" Foreground="#8BA7CC" Margin="4,0,0,4"/><TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Введите имя компьютера или название ОС" Margin="0,0,0,8"/><Button Content="Обновить из AD" Click="LoadDomain_Click" Background="#1E3A5F" Foreground="White"/><WrapPanel><Button Content="Выбрать ветку" Click="SelectVisible_Click" Background="#1E3A5F" Foreground="White"/><Button Content="Снять выбор" Click="ClearSelection_Click" Background="#1E3A5F" Foreground="White"/></WrapPanel><TextBlock x:Name="SelectedLabel" Foreground="#8BA7CC" Text="Выберите компьютеры" Margin="4,0,0,8"/></StackPanel><TreeView x:Name="OuTree" SelectedItemChanged="OuTree_Changed" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Stretch"><TreeView.Resources><Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="White"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></TreeView.Resources></TreeView></DockPanel></Border><GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#CBD5E1"/><Grid Grid.Column="2" Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="White" Padding="10,6" Margin="0,0,0,8"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Результаты" Click="Refresh_Click" Margin="8,0,0,0"/><Button Content="Подключение" Click="CheckConnection_Click" Margin="8,0,0,0"/></StackPanel><StackPanel><TextBlock x:Name="CurrentComputer" FontSize="17" FontWeight="SemiBold" Text="Выберите компьютер"/><TextBlock x:Name="CurrentDetails" Foreground="#64748B" TextWrapping="Wrap"/><TextBlock x:Name="CurrentStage" TextWrapping="Wrap" Margin="0,3,0,3"/><ProgressBar x:Name="CurrentProgress" Height="4" Maximum="100" Foreground="#2563EB"/></StackPanel></DockPanel></Border><DataGrid x:Name="ComputerGrid" Visibility="Collapsed" ItemsSource="{Binding Computers}" SelectionChanged="Computer_Changed"/>
 <TabControl x:Name="MainTabs" Grid.Row="1" BorderThickness="0" Background="White" TabStripPlacement="Left">
 <TabItem Header="Команды"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="1. Отметьте компьютеры в дереве слева.  2. Введите команду.  3. Нажмите «Выполнить команду»." TextWrapping="Wrap" Margin="0,0,0,12"/><WrapPanel><ComboBox x:Name="KindBox" SelectedIndex="0" Width="140" Margin="0,0,8,8"><ComboBoxItem Content="CMD"/><ComboBoxItem Content="PowerShell"/></ComboBox><TextBox x:Name="CommandName" Width="250" Text="Новая команда"/></WrapPanel></StackPanel><TextBox x:Name="Editor" Text="hostname" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></DockPanel><DockPanel Grid.Column="1" Margin="10,0,0,0"><StackPanel DockPanel.Dock="Bottom"><WrapPanel><Button Content="↑" Click="Up_Click"/><Button Content="↓" Click="Down_Click"/><Button Content="Удалить" Click="RemoveStep_Click"/></WrapPanel><CheckBox x:Name="MicrosoftBox" Content="Microsoft для восстановления"/><CheckBox x:Name="ContinueBox" Content="Продолжать после ошибки"/><CheckBox x:Name="RebootBox" Content="Автоперезагрузка · 15 минут"/><TextBlock Text="Параллельность: 0 — все компьютеры" Foreground="#64748B"/><TextBox x:Name="LimitBox" Text="0"/><Button Content="Выполнить последовательность" Style="{StaticResource Primary}" Click="Run_Click"/></StackPanel><DockPanel><StackPanel DockPanel.Dock="Top"><Button Content="Выполнить команду" Style="{StaticResource Primary}" Click="RunEditor_Click"/><Button Content="Добавить шаг" Click="AddStep_Click"/><Button Content="Применить правку" Click="EditStep_Click"/><Button Content="Открыть TXT" Click="ImportText_Click"/><Button Content="Добавить выделенное" Click="AddSelection_Click"/><TextBlock Text="Последовательность шагов" FontWeight="SemiBold"/><TextBlock Text="Выполняются только шаги из этого списка." TextWrapping="Wrap" Foreground="#64748B" Margin="0,5,0,10"/></StackPanel><ListBox x:Name="StepList" ItemsSource="{Binding Steps}" DisplayMemberPath="Name" SelectionChanged="Step_Changed" BorderThickness="0"/></DockPanel></DockPanel></Grid></TabItem>
 <TabItem Header="Библиотека"><DockPanel Margin="10"><StackPanel DockPanel.Dock="Right" Width="172" Margin="10,0,0,0"><Button Content="Сохранить набор" Click="SaveLibrary_Click"/><Button Content="Добавить в команды" Click="LoadLibrary_Click"/><Button Content="Удалить" Click="DeleteLibrary_Click"/><Button Content="Импорт JSON" Click="ImportLibrary_Click"/><Button Content="Экспорт JSON" Click="ExportLibrary_Click"/></StackPanel><TextBox x:Name="LibrarySearch" DockPanel.Dock="Top" TextChanged="LibrarySearch_Changed" ToolTip="Поиск по библиотеке"/><DataGrid x:Name="LibraryGrid" ItemsSource="{Binding Library}"><DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="160"/><DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/><DataGridCheckBoxColumn Header="★" Binding="{Binding Favorite}" Width="50"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
 <TabItem Header="Вывод и результат"><DockPanel Margin="10"><StackPanel DockPanel.Dock="Right" Width="172" Margin="10,0,0,0"><Button Content="Копировать результат" Click="CopyOutput_Click"/><Button Content="Сохранить в TXT" Click="SaveOutput_Click"/><Button Content="Остановить после шага" Click="Cancel_Click"/><Button Content="Отменить перезагрузку" Click="AbortReboot_Click"/><Button Content="Скачать журналы" Click="Logs_Click"/><Button Content="WindowsUpdate.log" Click="Diagnostics_Click"/></StackPanel><TextBox x:Name="OutputBox" TextWrapping="Wrap" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" Background="#102239" Foreground="#D7E6FA" BorderThickness="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></DockPanel></TabItem>
 <TabItem Header="История"><DockPanel Margin="10"><StackPanel DockPanel.Dock="Right" Width="172" Margin="10,0,0,0"><Button Content="Открыть задание" Click="OpenHistory_Click"/><Button Content="Продолжить очередь" Click="Resume_Click"/><Button Content="Повторить" Click="Retry_Click"/><Button Content="Экспорт CSV" Click="ExportCsv_Click"/></StackPanel><DataGrid x:Name="HistoryGrid" SelectionChanged="History_Changed" ItemsSource="{Binding History}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Создано" Binding="{Binding Created, Converter={StaticResource LocalDate}}" Width="200"/><DataGridTextColumn Header="Задание" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="ПК" Binding="{Binding Targets.Count}" Width="60"/><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="270"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
<TabItem Header="WSUS"><DockPanel Margin="10"><StackPanel DockPanel.Dock="Right" Width="182" Margin="10,0,0,0"><TextBlock x:Name="WsusHeader" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/><Button Content="Проверить обновления" Click="WsusScan_Click"/><Button Content="Установить обновления" Click="WsusInstall_Click"/><Button Content="Прочитать отчёт сервера" Click="Wsus_Click"/><Button Content="Диагностика клиента" Click="WsusDiagnostics_Click"/><Button Content="Обновить этап" Click="WsusClientRefresh_Click"/><Button Content="Скачать журналы" Click="Logs_Click"/><Button Content="Настройки WSUS" Click="WsusSettings_Click"/><TextBlock Text="Действия: отмеченные ПК. Вывод: выбранный ПК." TextWrapping="Wrap" Foreground="#64748B"/><TextBlock x:Name="WsusStage" Visibility="Collapsed"/><ProgressBar x:Name="WsusProgress" Visibility="Collapsed"/></StackPanel><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*" MinHeight="100"/><RowDefinition Height="6"/><RowDefinition Height="2*" MinHeight="80"/></Grid.RowDefinitions><TextBlock Text="Журнал клиента" Margin="0,0,0,6" FontWeight="SemiBold"/><TextBox Grid.Row="1" x:Name="WsusOutput" Margin="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Background="#102239" Foreground="#D7E6FA" VerticalScrollBarVisibility="Auto"/><GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="#CBD5E1"/><DockPanel Grid.Row="3"><TextBlock DockPanel.Dock="Top" Text="Отчёт сервера" Margin="0,6" FontWeight="SemiBold"/><TextBox x:Name="WsusServerOutput" Margin="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/></DockPanel></Grid></DockPanel></TabItem> <TabItem Header="Настройки"><StackPanel Margin="24" MaxWidth="650" HorizontalAlignment="Left"><TextBlock Text="Сервер WSUS" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock Text="Доменное имя сервера для административного подключения WinRM"/><TextBox x:Name="WsusHost" Width="420" HorizontalAlignment="Left"/><TextBlock Text="Порт WSUS API на сервере"/><TextBox x:Name="WsusPort" Text="8530" Width="100" HorizontalAlignment="Left"/><CheckBox x:Name="WsusSsl" Content="WSUS API использует HTTPS"/><TextBlock Text="Источник обновлений клиента читается из его политик WUServer / UseWUServer. Эти настройки приложения не меняют политики клиента." TextWrapping="Wrap" Foreground="#64748B" Margin="0,8,0,16"/><Button Content="Сохранить настройки" Style="{StaticResource Primary}" Click="SaveWsus_Click" HorizontalAlignment="Left"/></StackPanel></TabItem>
 </TabControl><DockPanel Grid.Row="2" Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="Копировать" Click="CopyError_Click" Margin="6,0,0,0"/><TextBox x:Name="StatusBar" Margin="0" Padding="6,4" IsReadOnly="True" Text="Готово. Отметьте компьютеры в дереве." TextWrapping="Wrap" MaxHeight="48" VerticalScrollBarVisibility="Auto"/></DockPanel></Grid></Grid></Window>