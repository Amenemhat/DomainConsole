<Window x:Class="DomainConsole.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DomainConsole" Title="Domain Console · 0.7" Icon="Assets/DomainConsole.ico" Width="1480" Height="940" MinWidth="1000" MinHeight="640" Background="#F4F7FB" FontFamily="Segoe UI" FontSize="13" Foreground="#0F172A">
 <Window.Resources><local:LocalDateConverter x:Key="LocalDate"/></Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="290" MinWidth="220" MaxWidth="440"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#102239"><DockPanel Margin="10"><StackPanel DockPanel.Dock="Top"><TextBlock Text="КОМПЬЮТЕРЫ" Foreground="#8BA7CC" FontWeight="SemiBold" Margin="4,0,0,8"/><TextBlock Text="Поиск по имени или ОС" Foreground="#8BA7CC" Margin="4,0,0,4"/><TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Введите имя компьютера или название ОС" Margin="0,0,0,8"/><Button Content="Обновить из AD" Click="LoadDomain_Click" Background="#1E3A5F" Foreground="White"/><WrapPanel><Button Content="Выбрать ветку" Click="SelectVisible_Click" Background="#1E3A5F" Foreground="White"/><Button Content="Снять выбор" Click="ClearSelection_Click" Background="#1E3A5F" Foreground="White"/></WrapPanel><TextBlock x:Name="SelectedLabel" Foreground="#8BA7CC" Text="Выберите компьютеры" Margin="4,0,0,8"/></StackPanel><TreeView x:Name="OuTree" SelectedItemChanged="OuTree_Changed" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Stretch"><TreeView.Resources><SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1E3A5F"/><SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2563EB"/><Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="White"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></TreeView.Resources></TreeView></DockPanel></Border><GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#CBD5E1"/><Grid Grid.Column="2" Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="White" Padding="10,6" Margin="0,0,0,8"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Результаты" Click="Refresh_Click" Margin="8,0,0,0"/><Button Content="Подключение" Click="CheckConnection_Click" Margin="8,0,0,0"/></StackPanel><StackPanel><TextBlock x:Name="CurrentComputer" FontSize="17" FontWeight="SemiBold" Text="Выберите компьютер"/><TextBlock x:Name="CurrentDetails" Foreground="#64748B" TextWrapping="Wrap"/><TextBlock x:Name="CurrentStage" TextWrapping="Wrap" Margin="0,3,0,3"/><ProgressBar x:Name="CurrentProgress" Height="4" Maximum="100" Foreground="#2563EB"/></StackPanel></DockPanel></Border><DataGrid x:Name="ComputerGrid" Visibility="Collapsed" ItemsSource="{Binding Computers}" SelectionChanged="Computer_Changed"/>
 <TabControl x:Name="MainTabs" Grid.Row="1" BorderThickness="0" Background="White" TabStripPlacement="Left" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" SelectionChanged="Tabs_Changed">
<TabItem x:Name="CommandsTab" Header="Команды"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
 <Grid x:Name="CommandWorkspace"><Grid.RowDefinitions><RowDefinition x:Name="EditorRow" Height="0.24*" MinHeight="70"/><RowDefinition Height="6"/><RowDefinition x:Name="ResultRow" Height="0.76*" MinHeight="100"/></Grid.RowDefinitions>
 <DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,6"><ComboBox x:Name="KindBox" SelectedIndex="0" Width="125" DockPanel.Dock="Right" Margin="6,0,0,0"><ComboBoxItem Content="CMD"/><ComboBoxItem Content="PowerShell"/></ComboBox><TextBlock Text="Команда или скрипт" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBox x:Name="Editor" Margin="0" Text="hostname" TextChanged="Editor_Changed" PreviewKeyDown="Editor_KeyDown" LostKeyboardFocus="Editor_LostFocus" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/></DockPanel>
 <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#CBD5E1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" DragCompleted="CommandSplit_Changed" ToolTip="Изменить высоту редактора и результата"/>
 <DockPanel Grid.Row="2"><TextBlock DockPanel.Dock="Top" Text="Результат команды · выбранный компьютер" FontWeight="SemiBold" Margin="0,6,0,6"/><TextBox x:Name="OutputBox" Margin="0" TextWrapping="Wrap" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" Background="#102239" Foreground="#D7E6FA" BorderThickness="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/></DockPanel>
 </Grid>
 <ScrollViewer Grid.Column="1" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><Button Content="Выполнить команду" Style="{StaticResource Primary}" Click="RunEditor_Click"/><Button Content="Сохранённые / недавние ▾" Click="ShowSuggestions_Click"/><Button Content="Копировать результат" Click="CopyOutput_Click"/><Button Content="Сохранить результат в TXT" Click="SaveOutput_Click"/><Button Content="Остановить после шага" Click="Cancel_Click"/><Button Content="Скачать журналы" Click="Logs_Click"/><Button Content="Открыть TXT / скрипт" Click="ImportText_Click"/>
 <Expander x:Name="CommandOptions" Header="Шаги и параметры" Margin="0,4,0,0"><StackPanel Margin="0,8,0,0"><Button Content="Добавить шаг" Click="AddStep_Click"/><Button Content="Добавить выделенное" Click="AddSelection_Click"/><Button Content="Применить правку шага" Click="EditStep_Click"/><ListBox x:Name="StepList" Height="110" ItemsSource="{Binding Steps}" DisplayMemberPath="Name" SelectionChanged="Step_Changed"/><WrapPanel><Button Content="↑" Click="Up_Click"/><Button Content="↓" Click="Down_Click"/><Button Content="Удалить" Click="RemoveStep_Click"/></WrapPanel><Button Content="Выполнить набор шагов" Click="Run_Click" Style="{StaticResource Primary}"/><Button Content="Сохранить набор" Click="SaveLibrary_Click"/><Button Content="Импорт JSON" Click="ImportLibrary_Click"/><Button Content="Экспорт JSON" Click="ExportLibrary_Click"/><CheckBox x:Name="MicrosoftBox" Content="Microsoft для восстановления"/><CheckBox x:Name="ContinueBox" Content="Продолжать после ошибки"/><CheckBox x:Name="RebootBox" Content="Автоперезагрузка · 15 минут"/><Button Content="Отменить перезагрузку" Click="AbortReboot_Click"/><TextBlock Text="Параллельность: 0 — все ПК" Foreground="#64748B"/><TextBox x:Name="LimitBox" Text="0"/></StackPanel></Expander>
 <TextBlock Text="Подсказки появляются при вводе. Выбор подставляет команду; запуск — отдельной кнопкой." TextWrapping="Wrap" Foreground="#64748B" Margin="0,10,0,0"/></StackPanel></ScrollViewer>
 <Popup x:Name="SuggestionsPopup" PlacementTarget="{Binding ElementName=Editor}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True"><Border x:Name="SuggestionBorder" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="6" MaxWidth="700"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Сохранённые и недавние · Enter — выбрать, Esc — закрыть" Foreground="#64748B" Margin="4,2,4,6" TextWrapping="Wrap"/><ListBox x:Name="SuggestionList" ItemsSource="{Binding Suggestions}" MaxHeight="240" BorderThickness="0" PreviewMouseLeftButtonUp="Suggestion_Click" PreviewKeyDown="Suggestion_KeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel ToolTip="{Binding Preview}" Margin="3"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="#64748B" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border></Popup>
 </Grid></TabItem>
 <TabItem x:Name="HistoryTab" Header="История"><DockPanel Margin="10"><StackPanel DockPanel.Dock="Right" Width="172" Margin="10,0,0,0"><Button Content="Открыть задание" Click="OpenHistory_Click"/><Button Content="Продолжить очередь" Click="Resume_Click"/><Button Content="Повторить" Click="Retry_Click"/><Button Content="Экспорт CSV" Click="ExportCsv_Click"/></StackPanel><DataGrid x:Name="HistoryGrid" SelectionChanged="History_Changed" ItemsSource="{Binding History}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Создано" Binding="{Binding Created, Converter={StaticResource LocalDate}}" Width="200"/><DataGridTextColumn Header="Задание" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="ПК" Binding="{Binding Targets.Count}" Width="60"/><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="270"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
<TabItem x:Name="WsusTab" Header="WSUS"><DockPanel Margin="10"><StackPanel DockPanel.Dock="Right" Width="182" Margin="10,0,0,0"><TextBlock x:Name="WsusHeader" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/><Button Content="Проверить обновления" Click="WsusScan_Click"/><Button Content="Установить обновления" Click="WsusInstall_Click"/><Button Content="Прочитать отчёт сервера" Click="Wsus_Click"/><Button Content="Диагностика клиента" Click="WsusDiagnostics_Click"/><Button Content="Обновить этап" Click="WsusClientRefresh_Click"/><Button Content="Скачать журналы" Click="Logs_Click"/><Button Content="Настройки WSUS" Click="WsusSettings_Click"/><TextBlock Text="Действия: отмеченные ПК. Вывод: выбранный ПК." TextWrapping="Wrap" Foreground="#64748B"/><TextBlock x:Name="WsusStage" Visibility="Collapsed"/><ProgressBar x:Name="WsusProgress" Visibility="Collapsed"/></StackPanel><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*" MinHeight="100"/><RowDefinition Height="6"/><RowDefinition Height="2*" MinHeight="80"/></Grid.RowDefinitions><TextBlock Text="Журнал клиента" Margin="0,0,0,6" FontWeight="SemiBold"/><TextBox Grid.Row="1" x:Name="WsusOutput" Margin="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Background="#102239" Foreground="#D7E6FA" VerticalScrollBarVisibility="Auto"/><GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="#CBD5E1"/><DockPanel Grid.Row="3"><TextBlock DockPanel.Dock="Top" Text="Отчёт сервера" Margin="0,6" FontWeight="SemiBold"/><TextBox x:Name="WsusServerOutput" Margin="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/></DockPanel></Grid></DockPanel></TabItem> <TabItem x:Name="SettingsTab" Header="Настройки"><StackPanel Margin="24" MaxWidth="650" HorizontalAlignment="Left"><TextBlock Text="Сервер WSUS" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock Text="Доменное имя сервера для административного подключения WinRM"/><TextBox x:Name="WsusHost" Width="420" HorizontalAlignment="Left"/><TextBlock Text="Порт WSUS API на сервере"/><TextBox x:Name="WsusPort" Text="8530" Width="100" HorizontalAlignment="Left"/><CheckBox x:Name="WsusSsl" Content="WSUS API использует HTTPS"/><TextBlock Text="Источник обновлений клиента читается из его политик WUServer / UseWUServer. Эти настройки приложения не меняют политики клиента." TextWrapping="Wrap" Foreground="#64748B" Margin="0,8,0,16"/><Button Content="Сохранить настройки" Style="{StaticResource Primary}" Click="SaveWsus_Click" HorizontalAlignment="Left"/></StackPanel></TabItem>
 </TabControl><DockPanel Grid.Row="2" Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="Копировать" Click="CopyError_Click" Margin="6,0,0,0"/><TextBox x:Name="StatusBar" Margin="0" Padding="6,4" IsReadOnly="True" Text="Готово. Отметьте компьютеры в дереве." TextWrapping="Wrap" MaxHeight="48" VerticalScrollBarVisibility="Auto"/></DockPanel></Grid></Grid></Window>