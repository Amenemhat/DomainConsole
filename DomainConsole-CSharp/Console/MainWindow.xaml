<Window x:Class="DomainConsole.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DomainConsole" Title="Domain Console · 0.4" Icon="Assets/DomainConsole.ico" Width="1480" Height="940" MinWidth="1150" MinHeight="750" Background="#F4F7FB" FontFamily="Segoe UI" FontSize="13" Foreground="#0F172A">
 <Window.Resources><local:LocalDateConverter x:Key="LocalDate"/></Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="#102239"><DockPanel Margin="20"><StackPanel DockPanel.Dock="Top"><TextBlock Text="◈  DOMAIN" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="CONSOLE" Foreground="#8BA7CC" FontSize="12" Margin="31,2,0,30"/><TextBlock Text="ИНФРАСТРУКТУРА" Foreground="#8BA7CC" FontSize="10" Margin="0,0,0,12"/><Button Content="Обновить из AD" Click="LoadDomain_Click" Background="#1E3A5F" Foreground="White"/><Button Content="Выбрать видимые" Click="SelectVisible_Click" Background="#1E3A5F" Foreground="White"/><Button Content="Снять выбор" Click="ClearSelection_Click" Background="#1E3A5F" Foreground="White"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="C# · Windows Desktop&#10;Контекст задания: SYSTEM" Foreground="#8BA7CC" Margin="0,20,0,0"/><TreeView x:Name="OuTree" SelectedItemChanged="OuTree_Changed" Background="Transparent" Foreground="White" BorderThickness="0"><TreeView.Resources><Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="White"/></Style></TreeView.Resources></TreeView></DockPanel></Border>
 <Grid Grid.Column="1" Margin="28,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid><TextBlock Text="Управление компьютерами" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="SelectedLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#64748B" Text="Выберите компьютеры"/></Grid>
 <DockPanel Grid.Row="1" Margin="0,16,0,12"><Button DockPanel.Dock="Right" Content="Проверить подключение" Click="CheckConnection_Click"/><Button DockPanel.Dock="Right" Content="Получить результаты" Click="Refresh_Click"/><TextBox x:Name="SearchBox" TextChanged="Search_Changed" Width="330" HorizontalAlignment="Left" ToolTip="Поиск по имени или ОС"/></DockPanel>
 <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="6" Margin="0,0,0,18"><DataGrid x:Name="ComputerGrid" ItemsSource="{Binding Computers}" SelectionChanged="Computer_Changed"><DataGrid.Columns><DataGridCheckBoxColumn Header="✓" Width="42" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Компьютер" Width="160" Binding="{Binding Name}" IsReadOnly="True"/><DataGridTextColumn Header="Операционная система" Width="210" Binding="{Binding OS}" IsReadOnly="True"/><DataGridTextColumn Header="Состояние" Width="150" Binding="{Binding Status}" IsReadOnly="True"/><DataGridTextColumn Header="Текущий этап" Width="*" Binding="{Binding Stage}" IsReadOnly="True"/><DataGridTemplateColumn Header="Прогресс" Width="115"><DataGridTemplateColumn.CellTemplate><DataTemplate><ProgressBar Height="6" Margin="8" Value="{Binding Progress, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding Busy}" Foreground="#2563EB" Background="#E2E8F0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border>
 <TabControl x:Name="MainTabs" Grid.Row="3" BorderThickness="0" Background="White">
 <TabItem Header="Команды"><Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="1. Отметьте компьютеры выше.  2. Введите команду.  3. Нажмите «Выполнить команду из редактора»." TextWrapping="Wrap" Margin="0,0,0,12"/><WrapPanel><ComboBox x:Name="KindBox" SelectedIndex="0" Width="140" Margin="0,0,8,8"><ComboBoxItem Content="CMD"/><ComboBoxItem Content="PowerShell"/></ComboBox><TextBox x:Name="CommandName" Width="250" Text="Новая команда"/></WrapPanel><WrapPanel><Button Content="Выполнить команду из редактора" Style="{StaticResource Primary}" Click="RunEditor_Click"/><Button Content="Добавить в последовательность" Click="AddStep_Click"/><Button Content="Применить правку шага" Click="EditStep_Click"/><Button Content="Открыть TXT" Click="ImportText_Click"/><Button Content="Добавить выделенное" Click="AddSelection_Click"/></WrapPanel></StackPanel><TextBox x:Name="Editor" Text="hostname" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></DockPanel><DockPanel Grid.Column="1" Margin="16,0,0,0"><StackPanel DockPanel.Dock="Bottom"><WrapPanel><Button Content="↑" Click="Up_Click"/><Button Content="↓" Click="Down_Click"/><Button Content="Удалить" Click="RemoveStep_Click"/></WrapPanel><CheckBox x:Name="MicrosoftBox" Content="Microsoft для восстановления"/><CheckBox x:Name="ContinueBox" Content="Продолжать после ошибки"/><CheckBox x:Name="RebootBox" Content="Автоперезагрузка · 15 минут"/><TextBlock Text="Параллельность: 0 — все компьютеры" Foreground="#64748B"/><TextBox x:Name="LimitBox" Text="0"/><Button Content="Выполнить последовательность →" Style="{StaticResource Primary}" Click="Run_Click"/></StackPanel><StackPanel><TextBlock Text="Последовательность шагов" FontWeight="SemiBold"/><TextBlock Text="Выполняются только шаги из этого списка." TextWrapping="Wrap" Foreground="#64748B" Margin="0,5,0,10"/><ListBox x:Name="StepList" ItemsSource="{Binding Steps}" DisplayMemberPath="Name" SelectionChanged="Step_Changed" BorderThickness="0"/></StackPanel></DockPanel></Grid></TabItem>
 <TabItem Header="Библиотека"><DockPanel Margin="18"><WrapPanel DockPanel.Dock="Top"><Button Content="Сохранить последовательность" Click="SaveLibrary_Click"/><Button Content="Добавить в команды" Click="LoadLibrary_Click"/><Button Content="Удалить" Click="DeleteLibrary_Click"/><Button Content="Импорт JSON" Click="ImportLibrary_Click"/><Button Content="Экспорт JSON" Click="ExportLibrary_Click"/></WrapPanel><TextBox x:Name="LibrarySearch" DockPanel.Dock="Top" TextChanged="LibrarySearch_Changed" ToolTip="Поиск по библиотеке"/><DataGrid x:Name="LibraryGrid" ItemsSource="{Binding Library}"><DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="160"/><DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/><DataGridCheckBoxColumn Header="★" Binding="{Binding Favorite}" Width="50"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
 <TabItem Header="Вывод и результат"><DockPanel Margin="18"><WrapPanel DockPanel.Dock="Top"><Button Content="Копировать результат" Click="CopyOutput_Click"/><Button Content="Сохранить в TXT" Click="SaveOutput_Click"/><Button Content="Остановить после шага" Click="Cancel_Click"/><Button Content="Отменить перезагрузку" Click="AbortReboot_Click"/><Button Content="Скачать журналы" Click="Logs_Click"/><Button Content="WindowsUpdate.log" Click="Diagnostics_Click"/></WrapPanel><TextBox x:Name="OutputBox" TextWrapping="Wrap" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" Background="#102239" Foreground="#D7E6FA" BorderThickness="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></DockPanel></TabItem>
 <TabItem Header="История"><DockPanel Margin="18"><WrapPanel DockPanel.Dock="Top"><Button Content="Открыть задание" Click="OpenHistory_Click"/><Button Content="Продолжить очередь" Click="Resume_Click"/><Button Content="Повторить" Click="Retry_Click"/><Button Content="Экспорт CSV" Click="ExportCsv_Click"/></WrapPanel><DataGrid x:Name="HistoryGrid" SelectionChanged="History_Changed" ItemsSource="{Binding History}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Создано" Binding="{Binding Created, Converter={StaticResource LocalDate}}" Width="200"/><DataGridTextColumn Header="Задание" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="ПК" Binding="{Binding Targets.Count}" Width="60"/><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="270"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
 <TabItem Header="WSUS"><DockPanel Margin="18"><WrapPanel DockPanel.Dock="Top"><TextBox x:Name="WsusHost" Width="250" ToolTip="Сервер WSUS"/><TextBox x:Name="WsusPort" Text="8530" Width="80"/><CheckBox x:Name="WsusSsl" Content="SSL"/><Button Content="Проверить отчёт выбранного ПК" Click="Wsus_Click"/></WrapPanel><TextBox x:Name="WsusOutput" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/></DockPanel></TabItem>
 </TabControl><DockPanel Grid.Row="4" Margin="0,14,0,0"><Button DockPanel.Dock="Right" Content="Копировать сообщение" Click="CopyError_Click"/><TextBox x:Name="StatusBar" IsReadOnly="True" Text="Готово. Отметьте компьютеры и введите команду." Foreground="#334155" TextWrapping="Wrap" MaxHeight="70" VerticalScrollBarVisibility="Auto"/></DockPanel>
 </Grid></Grid>
</Window>
