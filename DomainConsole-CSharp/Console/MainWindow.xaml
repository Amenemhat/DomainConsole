ендуемое действие…" Click="Recommendation_Click" Visibility="Collapsed" HorizontalAlignment="Left"/><TextBlock x:Name="DiagnosticStage" TextWrapping="Wrap" Foreground="#64748B" Visibility="Collapsed" Margin="0,2,0,3"/><ProgressBar x:Name="CurrentProgress" Height="4" Maximum="100" Foreground="#2563EB"/></StackPanel></DockPanel></Border><DataGrid x:Name="ComputerGrid" Visibility="Collapsed" ItemsSource="{Binding Computers}" SelectionChanged="Computer_Changed"/>
