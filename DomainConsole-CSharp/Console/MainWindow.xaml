 <DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,6"><ComboBox x:Name="KindBox" SelectedIndex="0" Width="125" DockPanel.Dock="Right" Margin="6,0,0,0"><ComboBoxItem Content="CMD"/><ComboBoxItem Content="PowerShell"/></ComboBox><TextBlock Text="Команда или скрипт" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><CheckBox DockPanel.Dock="Bottom" x:Name="MicrosoftBox" Content="Microsoft Update для восстановления" Margin="0,5,0,0" ToolTip="Меняет два параметра Windows Update только на время задания, затем возвращает их исходные значения. Kerio и другие сетевые блокировки не снимает. Если выключено, действуют политики клиента и параметры введённой команды."/><TextBox x:Name="Editor" Margin="0" Text="hostname" TextChanged="Editor_Changed" PreviewKeyDown="Editor_KeyDown" LostKeyboardFocus="Editor_LostFocus" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/></DockPanel>
