<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:DomainConsole" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DomainConsole.MainWindow" Title="DomainConsole" Icon="Assets/DomainConsole.ico" Width="1480" Height="940" MinWidth="1000" MinHeight="640" Background="{DynamicResource AppSurface}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource TextPrimary}">
  <Window.Resources>
    <local:LocalDateConverter x:Key="LocalDate" />
    <Style x:Key="HistoryCell" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self}}" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250" MinWidth="220" MaxWidth="440" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarSurface}">
      <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top">
          <DockPanel Margin="0,0,0,5">
            <Button DockPanel.Dock="Right" local:UiIcon32.Icon="add" Width="32" Click="AddAddress_Click" ToolTip="Добавить компьютер по IP или указать VPN-адрес существующему клиенту" Style="{StaticResource IconButton}" Margin="4,0,0,0" />
            <Grid>
              <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Поиск по имени, ОС или адресу; плюс добавляет IP" Margin="0" Height="30" />
              <TextBlock Text="Поиск имени или IP" Margin="7,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value="">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </DockPanel>
          <DockPanel>
            <Button x:Name="OverviewRefresh" local:UiIcon32.Icon="refresh" Click="OverviewRefresh_Click" Background="{DynamicResource SidebarSurface}" Foreground="{DynamicResource TextPrimary}" ToolTip="Прочитать данные WSUS и опросить клиентов: связь, флаги перезагрузки и аптайм. Поиск/установка не запускаются. Повторное нажатие останавливает обзор." Style="{StaticResource IconButton}" DockPanel.Dock="Right" Margin="4,0,0,0" />
            <Button x:Name="StatusFilterButton" Content="Статусы: все" Click="StatusFilter_Click" Background="{DynamicResource SidebarSurface}" Foreground="{DynamicResource TextPrimary}" ToolTip="Несколько статусов со счётчиками; фильтр, отметка галочками и добавление в работу — отдельные действия. Счётчики учитывают поиск и выбранную область." Margin="0" Padding="6,4" />
          </DockPanel>
          <TextBlock x:Name="OverviewProgress" Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="NoWrap" Margin="4,2,0,5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" />
        </StackPanel>
        <TextBlock x:Name="SelectedLabel" Foreground="{DynamicResource TextMuted}" Text="Выберите компьютеры" Margin="3,5,0,0" DockPanel.Dock="Bottom" />
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition x:Name="RecentRow" Height="0.38*" />
            <RowDefinition Height="6" />
            <RowDefinition x:Name="TreeRow" Height="0.62*" />
          </Grid.RowDefinitions>
          <Expander x:Name="RecentGroup" Header="Последние в работе" Foreground="{DynamicResource TextPrimary}" IsExpanded="True" Expanded="NavigationGroup_Changed" Collapsed="NavigationGroup_Changed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <ListBox x:Name="RecentList" ItemsSource="{Binding RecentComputers}" SelectionChanged="Recent_Changed" PreviewMouseLeftButtonDown="Recent_PreviewMouseDown" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                  <Setter Property="Padding" Value="2,1" />
                  <Setter Property="Margin" Value="0,1" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0">
                    <Border Background="{Binding ActivityBrush}" CornerRadius="4" />
                    <ProgressBar x:Name="RecentActivityFill" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0" Opacity="0.42" IsHitTestVisible="False" Focusable="False" Maximum="100" Value="{Binding WorkProgress,Mode=OneWay}" IsIndeterminate="{Binding WorkBusy}" Visibility="{Binding ActivityVisibility}" Foreground="{DynamicResource InfoText}" Background="Transparent" />
                    <DockPanel Margin="2,1">
                      <local:StatusGlyph DockPanel.Dock="Right" Kind="{Binding LinkKind}" Tint="{Binding LinkBrush}" ToolTip="{Binding LinkHint}" Margin="5,0,0,0" />
                      <local:StatusGlyph DockPanel.Dock="Right" Kind="{Binding Outcome}" Tint="{Binding OutcomeBrush}" ToolTip="{Binding OutcomeHint}" Margin="6,0,0,0" />
                      <CheckBox DockPanel.Dock="Left" Click="RecentCheck_Click" IsChecked="{Binding Selected,Mode=TwoWay}" Margin="0,0,7,0" ToolTip="Галочка выбирает цель; Shift — видимый диапазон. Имя открывает результат, Ctrl по имени переключает галочку." />
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding RecentHint}" FontSize="10" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Expander>
          <GridSplitter x:Name="NavigationSplitter" Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="{DynamicResource Outline}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" DragCompleted="NavigationSplit_Changed" ToolTip="Перетащите, чтобы изменить высоту списков" Margin="0">
            <GridSplitter.Template>
              <ControlTemplate TargetType="GridSplitter">
                <Border Background="{TemplateBinding Background}">
                  <Border Background="{DynamicResource TextMuted}" Width="36" Height="2" CornerRadius="1" />
                </Border>
              </ControlTemplate>
            </GridSplitter.Template>
          </GridSplitter>
          <Expander x:Name="TreeGroup" Grid.Row="2" Foreground="{DynamicResource TextPrimary}" IsExpanded="True" Expanded="NavigationGroup_Changed" Collapsed="NavigationGroup_Changed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Expander.Header>
              <DockPanel LastChildFill="True">
                <Button local:UiIcon32.Icon="refresh" Click="LoadDomain_Click" Background="{DynamicResource SidebarSurface}" Foreground="{DynamicResource TextPrimary}" ToolTip="Загрузить компьютеры и подразделения из AD. Сохранённая история заданий остаётся доступной." Style="{StaticResource IconButton}" DockPanel.Dock="Right" Margin="4,0,0,0" />
                <TextBlock x:Name="TreeLabel32" Text="Дерево AD" VerticalAlignment="Center" />
              </DockPanel>
            </Expander.Header>
            <TreeView x:Name="OuTree" SelectedItemChanged="OuTree_Changed" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" HorizontalContentAlignment="Stretch">
              <TreeView.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1E3A5F" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2A4863" />
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource DomainTreeItem}" />
              </TreeView.Resources>
            </TreeView>
          </Expander>
        </Grid>
      </DockPanel>
    </Border>
    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Outline}" />
    <Grid Grid.Column="2" Margin="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource PanelSurface}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,6" x:Name="CompactHeader32">
        <StackPanel>
          <Grid x:Name="IdentityHeader34" SizeChanged="IdentityHeader34_SizeChanged">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="HeaderActions34" Background="{DynamicResource HeaderSurface}" Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
              <RadioButton x:Name="CommandsNavigation33" Content="Команды" Tag="Commands" GroupName="HeaderViews33" Style="{StaticResource HeaderNavigation33}" Click="HeaderNavigation33_Click" />
              <RadioButton x:Name="WsusNavigation33" Content="WSUS" Tag="Wsus" GroupName="HeaderViews33" Style="{StaticResource HeaderNavigation33}" Click="HeaderNavigation33_Click" />
              <RadioButton x:Name="HistoryNavigation33" Content="История" Tag="History" GroupName="HeaderViews33" Style="{StaticResource HeaderNavigation33}" Click="HeaderNavigation33_Click" />
              <CheckBox x:Name="AutoServiceToggle" Content="Авто" Checked="AutoService_Changed" Unchecked="AutoService_Changed" HorizontalAlignment="Left" ToolTip="Поиск → установка найденного → отчёт. После согласованной перезагрузки — продолжение. Выключено: одна операция. Произвольные команды не запускают обслуживание." Style="{StaticResource AutoSwitch}" Margin="6,0" VerticalAlignment="Center" />
              <Button x:Name="SettingsButton34" local:UiIcon32.Icon="settings" Style="{StaticResource GhostIconButton}" Click="WsusSettings_Click" ToolTip="Настройки программы" />
            </StackPanel>
              <Border Background="{DynamicResource StatusSurface}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="5" Padding="4,2" x:Name="ConnectionPanel32" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,0,6,0">
                <StackPanel>
                  <WrapPanel x:Name="ClientActions35" Orientation="Horizontal">
                    <Button x:Name="NameCopy35" Click="CopyComputer35_Click" Style="{StaticResource GhostButton}" Padding="4,3" Margin="0" ToolTip="Копировать имя компьютера" MinHeight="30">
                      <TextBlock x:Name="CurrentComputer" TextTrimming="CharacterEllipsis" FontSize="17" FontWeight="SemiBold" Text="Выберите компьютер" VerticalAlignment="Center" />
                    </Button>
                  <Button x:Name="HeaderLink" Click="HeaderLink_Click" Padding="4,3" ToolTip="Проверить связь" Margin="0" Style="{StaticResource GhostButton}" MinHeight="30">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Адрес и учётная запись…" Click="HeaderAddress_Click" />
                        <MenuItem Header="Подробная проверка подключения…" Click="CheckConnection_Click" />
                      </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                      <local:StatusGlyph x:Name="HeaderLinkGlyph" />
                      <TextBlock x:Name="HeaderLinkText" Margin="5,0" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                  </Button>
          <Button x:Name="HeaderReboot" Foreground="{DynamicResource InfoText}" local:UiIcon32.Icon="reboot" Click="HeaderReboot_Click" Style="{StaticResource GhostIconButton}" Margin="1,0" />
                  <Button x:Name="HeaderAbortReboot" AutomationProperties.Name="Отменить назначенную перезагрузку" Foreground="{DynamicResource ErrorText}" local:UiIcon32.Icon="close" Click="HeaderAbortReboot_Click" Visibility="Collapsed" Style="{StaticResource GhostIconButton}" Margin="1,0" ToolTip="Отменить назначенную перезагрузку" />
                  <Button x:Name="PostRebootInfo" Visibility="Collapsed" local:UiIcon32.Icon="more" Click="PostRebootInfo_Click" ToolTip="Состояние наблюдения и прекращение автоматического продолжения" Style="{StaticResource GhostIconButton}" Margin="1,0" />
                    <TextBlock x:Name="HeaderUpdateCount31" Margin="7,0" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                    <Button x:Name="HeaderErrors36" Content="Ошибок WSUS" Foreground="{DynamicResource ErrorText}" FontWeight="Bold" Click="HeaderErrors36_Click" Visibility="Collapsed" Style="{StaticResource GhostButton}" Margin="3,0" />
                    <TextBlock x:Name="HeaderReport35" Margin="7,0" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                  </WrapPanel>
                  <WrapPanel Orientation="Horizontal" Margin="4,1,0,0">
                    <TextBlock x:Name="CurrentDetails" Foreground="{DynamicResource TextMuted}" MaxWidth="250" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderTimes31" Margin="9,0" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderContact35" Margin="0,0,8,0" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderNext31" Foreground="{DynamicResource InfoText}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderWsusStatus" Visibility="Collapsed" />
                  </WrapPanel>
                </StackPanel>
              </Border>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CurrentStage" TextWrapping="Wrap" Margin="0,1" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" />
            </Grid>
          <ProgressBar x:Name="CurrentProgress" Height="2" Maximum="100" Foreground="{DynamicResource InfoText}" />
          <ItemsControl x:Name="HeaderRecent31" Margin="0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}" Foreground="{Binding Brush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" TextWrapping="Wrap" MaxHeight="36" LineHeight="16" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid Margin="0,3,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,6,0">
              <Button x:Name="HeaderEventHistory31" Content="История событий" Click="EventHistory_Click" HorizontalAlignment="Left" FontSize="11" Padding="5,2" Visibility="Collapsed" />
              <Expander x:Name="EventHistoryGroup32" Header="История событий" Expanded="EventHistory32_Changed" Collapsed="EventHistory32_Changed">
                <DockPanel>
                  <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <CheckBox x:Name="EventErrors32" Content="Ошибки и предупреждения" Margin="4,3" Checked="EventFilter32_Changed" Unchecked="EventFilter32_Changed" />
                    <Button x:Name="EventCopyOne36" Content="Запись" Click="CopyEventOne36_Click" IsEnabled="False" Padding="5,2" ToolTip="Копировать текущую запись с подробностями" />
                    <Button x:Name="EventCopySelected36" Content="Выбранные (0)" Click="CopyEventSelected36_Click" IsEnabled="False" Padding="5,2" ToolTip="Копировать отмеченные события" />
                    <Button Content="Все" Click="CopyEventAll36_Click" Padding="5,2" ToolTip="Копировать всю историю с учётом фильтра и подробностями" />
                    <Button x:Name="NewEvents35" Content="К новым ↑" Click="NewEvents35_Click" Padding="5,2" Visibility="Collapsed" />
                  </WrapPanel>
                  <TextBlock x:Name="EventStorageError32" DockPanel.Dock="Bottom" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{DynamicResource WarningText}" />
                  <ListBox x:Name="EventList32" PreviewMouseLeftButtonDown="EventSelect36_Mouse" SelectionChanged="EventCurrent36_Changed" MaxHeight="145" SelectionMode="Extended" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.ScrollChanged="EventScroll35_Changed" PreviewKeyDown="EventCopy35_KeyDown">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <DockPanel LastChildFill="True">
                          <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Selected36,Mode=TwoWay}" Checked="EventSelection36_Changed" Unchecked="EventSelection36_Changed" Margin="2,3,5,0" VerticalAlignment="Top" />
                          <Expander Foreground="{Binding Brush}">
                            <Expander.Header><TextBlock Text="{Binding Display}" Foreground="{Binding Brush}" TextWrapping="Wrap" /></Expander.Header>
                            <StackPanel><TextBox Text="{Binding Details,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto" /><TextBox Text="{Binding OccurrenceText36,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="110" VerticalScrollBarVisibility="Auto" /></StackPanel>
                          </Expander>
                        </DockPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Expander>
            </StackPanel>
            <Expander x:Name="BackgroundGroup" Margin="0" IsExpanded="False" Visibility="Collapsed" Grid.Column="1">
              <Expander.Header>
                <TextBlock x:Name="BackgroundSummary" TextWrapping="NoWrap" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" />
              </Expander.Header>
              <StackPanel MaxHeight="175">
                <TextBlock x:Name="BackgroundRelation" TextWrapping="Wrap" Margin="0,3" />
                <ProgressBar x:Name="BackgroundProgress" Height="4" Maximum="100" Visibility="Collapsed" />
                <TextBox x:Name="BackgroundDetails" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="145" VerticalScrollBarVisibility="Auto" Margin="0,4" />
                <Button x:Name="DownloadPriorityButton" Content="Скорость выбранной загрузки…" Click="DownloadPriority_Click" HorizontalAlignment="Left" Visibility="Collapsed" ToolTip="Выбрать конкретное задание BITS: повысить приоритет или вернуть исходный" />
              </StackPanel>
            </Expander>
          </Grid>
          <Button x:Name="RecommendationButton" Content="Рекомендуемое действие…" Click="Recommendation_Click" Visibility="Collapsed" HorizontalAlignment="Left" />
          <TextBlock x:Name="DiagnosticStage" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Visibility="Collapsed" Margin="0,2,0,3" />
        </StackPanel>
      </Border>
      <DataGrid x:Name="ComputerGrid" Visibility="Collapsed" ItemsSource="{Binding Computers}" SelectionChanged="Computer_Changed" />
      <TabControl x:Name="MainTabs" Grid.Row="1" BorderThickness="0" Background="{DynamicResource AppSurface}" TabStripPlacement="Top" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" SelectionChanged="Tabs_Changed">
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
          </ControlTemplate>
        </TabControl.Template>
        <TabItem x:Name="CommandsTab" Header="Команды">
          <Grid Margin="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="195" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="CommandWorkspace">
              <Grid.RowDefinitions>
                <RowDefinition x:Name="EditorRow" Height="0.3*" MinHeight="70" />
                <RowDefinition Height="6" />
                <RowDefinition x:Name="ResultRow" Height="0.7*" MinHeight="100" />
              </Grid.RowDefinitions>
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                  <ComboBox x:Name="KindBox" SelectionChanged="ShellMode_Changed" SelectedIndex="0" Width="125" DockPanel.Dock="Right" Margin="6,0,0,0">
                    <ComboBoxItem Content="CMD" />
                    <ComboBoxItem Content="PowerShell" />
                  </ComboBox>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Команда" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <CheckBox x:Name="MicrosoftBox" Content="Источник MU" ToolTip="Меняет два параметра Windows Update только на время задания, затем возвращает их исходные значения. Kerio и другие сетевые блокировки не снимает. Если выключено, действуют политики клиента и параметры введённой команды." Style="{StaticResource CommandOption33}" />
                    <CheckBox x:Name="TouchesUpdatesBox" Content="Затрагивает WU" ToolTip="Включите для своих скриптов обслуживания обновлений. Появится проверка активности с выбором действия; настройка сохраняется вместе с командой." Style="{StaticResource CommandOption33}" />
                  </StackPanel>
                </DockPanel>
                <TextBox x:Name="Editor" Margin="0" Text="hostname" TextChanged="Editor_Changed" PreviewKeyDown="Editor_KeyDown" LostKeyboardFocus="Editor_LostFocus" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
              </DockPanel>
              <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="{DynamicResource Outline}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" DragCompleted="CommandSplit_Changed" ToolTip="Изменить высоту редактора и результата" />
              <DockPanel Grid.Row="2">
                <TextBlock x:Name="OutputCaption" DockPanel.Dock="Top" Text="Результат команды · выбранный компьютер" FontWeight="SemiBold" Margin="0,6,0,6" Visibility="Collapsed" />
                <local:LogViewer x:Name="OutputBox" Margin="0" Caption="Вывод · CMD" />
              </DockPanel>
            </Grid>
            <ScrollViewer Grid.Column="1" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <Button x:Name="RunEditorButton" Content="Выполнить в CMD" Style="{StaticResource Primary}" Click="RunEditor_Click" ToolTip="Выполнить текст из редактора. В подтверждении выберите текущий ПК или все отмеченные цели." />
                <Button x:Name="StopButton" Content="Остановить…" Click="Cancel_Click" Background="#DC2626" Foreground="White" ToolTip="Выбрать остановку сейчас или после текущей команды. Действует на просматриваемый ПК." />
                <TextBlock Text="Сценарии" FontWeight="SemiBold" Margin="0,12,0,4" />
                <Button Content="Сохранённые / недавние ▾" Click="ShowSuggestions_Click" ToolTip="Выбрать сохранённую или ранее введённую команду. Выбор заполняет редактор, запуск выполняется отдельно." />
                <TextBlock Text="Диагностика" FontWeight="SemiBold" Margin="0,12,0,4" />
                <Button Content="Диагностика DISM / SFC" Click="ServicingDiagnostics_Click" ToolTip="Снять состояние процессов и журналы текущего ПК за интервал задания. Ничего не исправляет. Полный собранный TXT сохраняется в Data/Diagnostics." />
                <Button Content="Открыть TXT / скрипт" Click="ImportText_Click" ToolTip="Открыть TXT, CMD, BAT или PS1 в редакторе. Файл не выполняется автоматически." />
                <Expander x:Name="CommandOptions" Header="Шаги и параметры" Margin="0,4,0,0">
                  <StackPanel Margin="0,8,0,0">
                    <Button Content="Сохранить результат в TXT" Click="SaveOutput_Click" ToolTip="Сохранить показанный результат команды текущего компьютера в TXT." />
                    <Button Content="Добавить шаг" Click="AddStep_Click" ToolTip="Добавить текст редактора отдельным шагом в последовательность." />
                    <Button Content="Добавить выделенное" Click="AddSelection_Click" ToolTip="Добавить только выделенный фрагмент редактора отдельным шагом." />
                    <Button Content="Применить правку шага" Click="EditStep_Click" ToolTip="Заменить выбранный шаг текущим текстом редактора." />
                    <ListBox x:Name="StepList" Height="110" ItemsSource="{Binding Steps}" DisplayMemberPath="Name" SelectionChanged="Step_Changed" />
                    <WrapPanel>
                      <Button Style="{StaticResource IconButton}" local:UiIcon32.Icon="up" Click="Up_Click" ToolTip="Переместить выбранный шаг раньше в порядке выполнения." />
                      <Button Style="{StaticResource IconButton}" local:UiIcon32.Icon="down" Click="Down_Click" ToolTip="Переместить выбранный шаг позже в порядке выполнения." />
                      <Button Content="Удалить" Click="RemoveStep_Click" ToolTip="Удалить выбранный шаг из набора. Сохранённые задания не меняются." />
                    </WrapPanel>
                    <Button Content="Выполнить набор шагов" Click="Run_Click" Style="{StaticResource Primary}" ToolTip="Выполнить набор шагов сверху вниз. Цели выбираются в подтверждении." />
                    <Button Content="Сохранить набор" Click="SaveLibrary_Click" ToolTip="Сохранить текущий набор шагов и параметры в библиотеку команд." />
                    <Button Content="Импорт JSON" Click="ImportLibrary_Click" ToolTip="Добавить команды из JSON-библиотеки без автоматического выполнения." />
                    <Button Content="Экспорт JSON" Click="ExportLibrary_Click" ToolTip="Сохранить библиотеку команд в JSON для переноса или резервной копии." />
                    <CheckBox x:Name="ContinueBox" Content="Продолжать после ошибки" ToolTip="Следующие шаги будут выполнены даже после ненулевого кода. Итог сохранит ошибки предыдущих шагов." />
                    <CheckBox x:Name="RebootBox" Content="Автоперезагрузка · 15 минут" ToolTip="Разрешить перезагрузку при необходимости после задания с предупреждением 15 минут. По умолчанию выключено." />
                    <Button Content="Отменить перезагрузку" Click="AbortReboot_Click" ToolTip="Отменить ожидающую перезагрузку на текущем компьютере." />
                  </StackPanel>
                </Expander>
                <TextBlock Text="Подсказки появляются при вводе. Выбор подставляет команду; запуск — отдельной кнопкой." TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,10,0,0" />
              </StackPanel>
            </ScrollViewer>
            <Popup x:Name="SuggestionsPopup" PlacementTarget="{Binding ElementName=Editor}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
              <Border x:Name="SuggestionBorder" Background="{DynamicResource PanelSurface}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" Padding="6" MaxWidth="700">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="Сохранённые и недавние · Enter — выбрать, Esc — закрыть" Foreground="{DynamicResource TextMuted}" Margin="4,2,4,6" TextWrapping="Wrap" />
                  <ListBox x:Name="SuggestionList" ItemsSource="{Binding Suggestions}" MaxHeight="240" BorderThickness="0" PreviewMouseLeftButtonUp="Suggestion_Click" PreviewKeyDown="Suggestion_KeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel ToolTip="{Binding Preview}" Margin="3">
                          <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextMuted}" FontSize="11" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>
            </Popup>
          </Grid>
        </TabItem>
        <TabItem x:Name="HistoryTab" Header="История">
          <DockPanel Margin="10">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
              <ComboBox x:Name="HistoryChannel" Width="125" SelectedIndex="0" SelectionChanged="HistoryFilter_Changed" ToolTip="Показать все операции, команды или WSUS">
                <ComboBoxItem Content="Всё" />
                <ComboBoxItem Content="Команды" />
                <ComboBoxItem Content="WSUS" />
              </ComboBox>
              <StackPanel Orientation="Horizontal" Margin="8,0">
                <TextBlock Text="Клиент:" VerticalAlignment="Center" />
                <TextBox x:Name="HistoryClient" Width="150" Margin="4,0" TextChanged="HistoryFilter_Changed" ToolTip="Фильтр по имени клиента, в том числе внутри массовых заданий" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Команда / результат:" VerticalAlignment="Center" />
                <TextBox x:Name="HistoryQuery" Width="190" Margin="4,0" TextChanged="HistoryFilter_Changed" />
              </StackPanel>
              <CheckBox x:Name="HistoryCurrent" Content="Текущий компьютер" Checked="HistoryFilter_Changed" Unchecked="HistoryFilter_Changed" VerticalAlignment="Center" Margin="8,0" />
            </WrapPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
              <Button Content="Команды и параметры…" Click="HistoryDetails_Click" />
              <Button Content="Открыть результат" Click="OpenHistory_Click" />
              <Button Content="Остановить / отменить…" Click="StopHistory_Click" />
              <Button Content="Продолжить очередь…" Click="Resume_Click" ToolTip="Продолжить локальную очередь исходного массового задания; цели показаны в подтверждении." />
              <Button Content="Повторить…" Click="Retry_Click" />
              <Button Content="Экспорт CSV" Click="ExportCsv_Click" />
            </WrapPanel>
            <DataGrid x:Name="HistoryGrid" MouseDoubleClick="HistoryDetails_DoubleClick" SelectionChanged="History_Changed" ItemsSource="{Binding HistoryRows}" IsReadOnly="True" RowHeight="27" MinRowHeight="27" ColumnHeaderHeight="30" CanUserSortColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                  <Setter Property="Padding" Value="8,4" />
                </Style>
              </DataGrid.ColumnHeaderStyle>
              <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                  <Expander Header="Компьютеры этого запуска" IsExpanded="False" Margin="8,2">
                    <ItemsControl ItemsSource="{Binding BatchLines}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Margin="8,2" Text="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                </DataTemplate>
              </DataGrid.RowDetailsTemplate>
              <DataGrid.Columns>
                <DataGridTextColumn ElementStyle="{StaticResource HistoryCell}" Header="Дата и время" Binding="{Binding TimeText}" SortMemberPath="CreatedAt" Width="145" MinWidth="145" />
                <DataGridTextColumn ElementStyle="{StaticResource HistoryCell}" Header="Клиент" Binding="{Binding Client}" Width="125" MinWidth="125" />
                <DataGridTextColumn ElementStyle="{StaticResource HistoryCell}" Header="Раздел" Binding="{Binding Channel}" Width="75" MinWidth="75" />
                <DataGridTextColumn ElementStyle="{StaticResource HistoryCell}" Header="Действие" Binding="{Binding Action}" Width="155" MinWidth="155" />
                <DataGridTextColumn ElementStyle="{StaticResource HistoryCell}" Header="Команда / скрипт" Binding="{Binding Command}" Width="*" MinWidth="170" />
                <DataGridTextColumn ElementStyle="{StaticResource HistoryCell}" Header="Результат" Binding="{Binding Result}" Width="155" MinWidth="155" />
                <DataGridTextColumn ElementStyle="{StaticResource HistoryCell}" Header="Время" Binding="{Binding Duration}" SortMemberPath="DurationSeconds" Width="85" MinWidth="85" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem x:Name="WsusTab" Header="WSUS">
          <DockPanel Margin="10">
            <Border DockPanel.Dock="Right" Width="182" Margin="10,0,0,0">
              <StackPanel>
                <TextBlock x:Name="WsusHeader" Visibility="Collapsed" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="Обновления" FontWeight="SemiBold" Margin="0,4,0,4" />
                <Button Click="WsusScan_Click" ToolTip="Найти применимые обновления и запросить отчёт. При включённом автообслуживании найденные обновления затем устанавливаются.">
                  <TextBlock Text="Проверить" TextWrapping="Wrap" TextAlignment="Center" />
                </Button>
                <Button Click="WsusInstall_Click" ToolTip="Скачать и установить применимые одобренные обновления WSUS, затем запросить отчёт. Цели выбираются в подтверждении.">
                  <TextBlock Text="Установить" TextWrapping="Wrap" TextAlignment="Center" />
                </Button>
                <Button Click="FullMaintenance_Click" ToolTip="Поиск, скачивание и установка. После подтверждённой перезагрузки продолжает обслуживание; до 3 циклов. Самостоятельно компьютер не перезагружает.">
                  <TextBlock Text="Обслуживание…" TextWrapping="Wrap" TextAlignment="Center" />
                </Button>
                <Button x:Name="WsusStopButton" Content="Остановить…" Click="Cancel_Click" Background="#B94A48" Foreground="White" ToolTip="Запросить отмену WUA либо остановку после текущего обновления. Запрос не означает мгновенного завершения установщика." />
                <Button Click="Wsus_Click" ToolTip="Прочитать данные текущего компьютера или всех отмеченных целей с сервера WSUS. Область выбирается в подтверждении.">
                  <TextBlock Text="Отчёт WSUS" TextWrapping="Wrap" TextAlignment="Center" />
                </Button>
                <Button Margin="0,10,0,2" x:Name="AttentionButton" Content="Требуют внимания · 0" Click="Attention_Click" ToolTip="Клиенты, ожидающие перезагрузки или решения по сценарию обслуживания." />
                <Button x:Name="ServiceTools36" Click="ServiceTools36_Click" Margin="0,10,0,0" Padding="7,6"><Button.ToolTip>Все проверки клиента и действия восстановления</Button.ToolTip><TextBlock Text="Диагностика и восстановление…" TextWrapping="Wrap" TextAlignment="Center" /></Button>
                <Expander x:Name="WsusDiagnosticsGroup" Visibility="Collapsed" />
                <TextBlock x:Name="WsusStage" Visibility="Collapsed" />
                <ProgressBar x:Name="WsusProgress" Visibility="Collapsed" />
              </StackPanel>
            </Border>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" MinHeight="100" />
                <RowDefinition Height="6" />
                <RowDefinition Height="2*" MinHeight="80" />
              </Grid.RowDefinitions>
              <local:LogViewer Grid.Row="1" x:Name="WsusOutput" Margin="0" Caption="Журнал клиента" />
              <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="{DynamicResource Outline}" />
              <DockPanel Grid.Row="3">
                <TextBlock x:Name="WsusReportTitle" DockPanel.Dock="Top" Text="Данные сервера WSUS о выбранном ПК" Margin="0,6" FontWeight="SemiBold" Visibility="Collapsed" />
                <local:LogViewer x:Name="WsusServerOutput" Margin="0" FontFamily="Consolas" Caption="Отчёт WSUS" />
              </DockPanel>
            </Grid>
          </DockPanel>
        </TabItem>
        <TabItem x:Name="SettingsTab" Header="Настройки" Style="{StaticResource HiddenSettingsTab}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" MaxWidth="650" HorizontalAlignment="Left">
              <CheckBox x:Name="AutoScrollSetting" Content="Автопрокрутка журналов" Checked="AutoScroll_Changed" Unchecked="AutoScroll_Changed" ToolTip="Следовать за последними записями в журналах команд и WSUS. Настройка сохраняется." Margin="0,0,0,16" />
              <Button Content="Учётные данные подключения…" Click="ConnectionCredentials_Click" HorizontalAlignment="Left" ToolTip="Текущий вход Windows или одна защищённо сохранённая запись для разных клиентов" />
              <TextBlock Text="Обзор статусов" FontSize="18" FontWeight="SemiBold" />
              <CheckBox x:Name="OverviewAutomatic" Content="Обновлять статусы всех ПК при открытии и периодически" />
              <TextBlock Text="Интервал в часах (1–168). Чтение WSUS и состояния клиентов: перезагрузка и аптайм. Настройки клиентов не меняются." TextWrapping="Wrap" />
              <TextBox x:Name="OverviewHours" Text="24" Width="100" HorizontalAlignment="Left" />
              <TextBlock Text="После перезагрузки: период опроса, сек (30–600)" />
              <TextBox x:Name="RebootProbeSeconds" />
              <TextBlock Text="Пауза готовности служб, сек (0–1800)" />
              <TextBox x:Name="RebootSettleSeconds" />
              <CheckBox x:Name="PostRebootScan" Content="По умолчанию проверять обновления после назначенной перезагрузки" ToolTip="Продолжение определяется общим переключателем автообслуживания в шапке." />
              <Button Content="Сохранить параметры после перезагрузки" Click="SavePostReboot_Click" />
              <Button Content="Сохранить обзор статусов" Click="SaveOverview_Click" HorizontalAlignment="Left" />
              <Separator Margin="0,16" />
              <TextBlock Text="Связь и история событий" FontSize="18" FontWeight="SemiBold" />
              <CheckBox x:Name="LinkAutomatic31" Content="Постепенно перепроверять связь клиентов" />
              <TextBlock Text="Интервал на клиент, минут (1–1440)" />
              <TextBox x:Name="LinkInterval31" Width="100" HorizontalAlignment="Left" />
              <TextBlock Text="Хранить события клиента, дней (1–365)" />
              <TextBox x:Name="EventDays31" Width="100" HorizontalAlignment="Left" />
              <Button Content="Сохранить связь и историю" Click="SaveStatus31_Click" HorizontalAlignment="Left" />
              <TextBlock Text="Навигация и выполнение" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Компьютеров в списке последних (5–200); активные задания остаются видимыми" TextWrapping="Wrap" />
              <TextBox x:Name="RecentLimitBox" Text="20" Width="100" HorizontalAlignment="Left" />
              <TextBlock Text="Параллельность: 0 — без ограничения" />
              <TextBox x:Name="LimitBox" Text="0" Width="100" HorizontalAlignment="Left" />
              <Button Content="Сохранить параметры навигации" Click="SaveNavigation_Click" HorizontalAlignment="Left" ToolTip="Сохранить количество последних компьютеров и параллельность запусков." />
              <Separator Margin="0,16" />
              <TextBlock Text="Ожидание и оформление" FontWeight="SemiBold" />
              <TextBlock Text="Предупреждать после минут без изменения прогресса (1–120)" />
              <TextBox x:Name="StallMinutesBox" Text="10" Width="100" HorizontalAlignment="Left" />
              <ComboBox x:Name="ThemeBox" Width="240" HorizontalAlignment="Left" SelectedIndex="0">
                <ComboBoxItem Content="Серый" />
                <ComboBoxItem Content="Графит" />
                <ComboBoxItem Content="Лиловый" />
              </ComboBox>
              <Button Content="Сохранить ожидание и палитру" Click="SaveOperationSettings_Click" HorizontalAlignment="Left" />
              <Separator Margin="0,16" />
              <CheckBox x:Name="AutomaticDownloadRecovery" Content="Автоматически восстанавливать загрузку (одна попытка на ПК)" ToolTip="По умолчанию выключено. Только свежие данные без установки; перезапуск BITS, UsoSvc и wuauserv без очистки кэша." />
              <TextBlock Text="Минут непрерывного наблюдения без движения (10–180)" />
              <TextBox x:Name="DownloadWaitBox" Text="30" Width="100" HorizontalAlignment="Left" />
              <Button Content="Сохранить восстановление загрузки" Click="SaveDownloadSettings_Click" />
              <Button Content="Сбросить счётчики попыток" Click="ResetRecoveryAttempts_Click" />
              <TextBlock Text="Возраст отчёта для автоматической диагностики, часов (1–720)" />
              <TextBox x:Name="ReportAgeBox" Text="24" Width="100" HorizontalAlignment="Left" />
              <CheckBox x:Name="AutomaticReportRepair" ToolTip="После завершения обновлений: старый отчёт и накопившаяся старая очередь. Одна очистка EventCache на задержку отчёта, затем поиск и запрос отчёта без установки.">
                <TextBlock Text="Автоматически восстанавливать отчётность по подтверждённой рекомендации" TextWrapping="Wrap" Width="430" />
              </CheckBox>
              <Button Content="Сохранить параметры отчётности" Click="SaveReportAge_Click" HorizontalAlignment="Left" />
              <TextBlock Text="Сервер WSUS" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
              <TextBlock Text="Доменное имя сервера для административного подключения WinRM" />
              <TextBox x:Name="WsusHost" Width="420" HorizontalAlignment="Left" />
              <TextBlock Text="Порт WSUS API на сервере" />
              <TextBox x:Name="WsusPort" Text="8530" Width="100" HorizontalAlignment="Left" />
              <CheckBox x:Name="WsusSsl" Content="WSUS API использует HTTPS" />
              <TextBlock Text="Источник обновлений клиента читается из его политик WUServer / UseWUServer. Эти настройки приложения не меняют политики клиента." TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,16" />
              <Button Content="Сохранить настройки" Style="{StaticResource Primary}" Click="SaveWsus_Click" HorizontalAlignment="Left" ToolTip="Сохранить адрес и параметры административного подключения к серверу WSUS." />
              <Separator Margin="0,16" />
              <TextBlock Text="Очистка на клиентах: дней после сохранения журналов" />
              <TextBox x:Name="CopiedDays" Text="7" Width="90" HorizontalAlignment="Left" />
              <TextBlock Text="Дней хранения неполученных результатов" />
              <TextBox x:Name="UncopiedDays" Text="30" Width="90" HorizontalAlignment="Left" />
              <Button Content="Сохранить сроки очистки" Click="SaveRetention_Click" ToolTip="Сроки применяются при следующей передаче задания. Активные задания и действия после перезагрузки сохраняются." />
              <TextBlock Text="Диагностика: минут до начала задания" />
              <TextBox x:Name="DiagnosticMinutes" Text="15" Width="100" HorizontalAlignment="Left" ToolTip="Журналы от начала задания минус указанное число минут до текущего снимка. Без задания — последний час. Диапазон 0–1440." />
              <Button Content="Сохранить интервал диагностики" Click="SaveDiagnosticSettings_Click" HorizontalAlignment="Left" ToolTip="Сохранить интервал поиска предшествующих ошибок в диагностических журналах." />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
    <Border x:Name="Toast" Grid.ColumnSpan="3" Panel.ZIndex="100" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="540" Background="#E8EFF7" BorderBrush="#A2B5CB" BorderThickness="1" CornerRadius="5" Margin="12,85,20,0" Padding="10">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource GhostIconButton}" local:UiIcon32.Icon="close" Click="DismissToast_Click" ToolTip="Закрыть уведомление" />
        <TextBlock x:Name="ToastText" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
  </Grid>
</Window>